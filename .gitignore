# FieldFix .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
.venv/
env/

# Environment files
.env
**/.env
!.env.example

# Databases
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Uploads
**/uploads/*
!**/uploads/.gitkeep

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo
.expo/
dist/
web-build/

# React Native
*.hbc

# Testing
.coverage
htmlcov/
.pytest_cache/

# Alembic
alembic/versions/*.pyc
